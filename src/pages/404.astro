---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Page not found · Harrison Keith">
  <section class="max-w-6xl mx-auto w-full px-6 pt-14">
    <PageHeading title="Page not found" intro="That page doesn't exist, or it has moved." />
    <a href="/" class="inline-flex items-center gap-3 px-5 py-3 bg-carbon text-chalk font-technical uppercase text-xs font-bold hover:bg-racingRed">
      <Icon name="direction" mono />
      Back to home
    </a>
  </section>
</Layout>
