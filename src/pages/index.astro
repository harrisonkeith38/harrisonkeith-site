---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Harrison Keith">
  <section class="max-w-6xl mx-auto px-6 pt-16 sm:pt-24 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-8 space-y-6">
        <h1>
          <img src="/brand/hk-wordmark.png" alt="Harrison Keith" width="847" height="46" class="w-full max-w-xl h-auto" />
        </h1>

        <span class="flex items-center gap-1.5" aria-hidden="true">
          <span class="w-12 sm:w-16 h-2.5 bg-signalYellow transform -skew-x-12 inline-block"></span>
          <span class="w-12 sm:w-16 h-2.5 bg-racingRed transform -skew-x-12 inline-block"></span>
          <span class="w-12 sm:w-16 h-2.5 bg-alpineBlue transform -skew-x-12 inline-block"></span>
        </span>

        <p class="text-lg sm:text-xl text-carbon max-w-md">
          MBA candidate at Texas McCombs. U.S. Army veteran.
        </p>

        <div class="pt-2 flex flex-wrap gap-4 text-xs font-technical uppercase tracking-extended">
          <a
            href="https://www.linkedin.com/in/harrison-keith38/"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-5 py-3 bg-carbon text-chalk font-bold hover:bg-racingRed transition-colors"
          >
            <Icon name="communication" mono />
            LinkedIn
          </a>
        </div>
      </div>

      <div class="md:col-span-4 flex justify-start md:justify-end">
        <div class="w-full max-w-[270px] aspect-[4/5] border border-concrete/40 overflow-hidden">
          <img
            src="/images/harrison-keith.jpg"
            alt="Harrison Keith"
            class="w-full h-full object-cover grayscale contrast-110 hover:grayscale-0 transition-all duration-500"
          />
        </div>
      </div>
    </div>
  </section>
</Layout>
