---
import Layout from '../layouts/Layout.astro';
import ProjectTicker from '../components/ProjectTicker.astro';
import { projects } from '../data/projects';
import { artifacts } from '../data/interests';

const selectedProjects = projects.slice(0, 3);
const previewArtifacts = artifacts.filter(a => a.featured).slice(0, 3);
---

<Layout title="Harrison Keith — Brand Strategy, Operations & Leadership">
  <!-- 01. Massive Editorial Masthead Hero -->
  <section class="max-w-7xl mx-auto px-6 sm:px-8 pt-20 sm:pt-28 pb-16">
    <div class="space-y-8 max-w-5xl">
      <!-- Metadata Tag -->
      <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-graphite-500">
        <span class="w-1.5 h-1.5 rounded-full bg-burnt-600"></span>
        <span>Portfolio & Strategic Archive</span>
        <span class="text-bone-400">/</span>
        <span>Austin, Texas</span>
      </div>

      <!-- Main Unapologetic Headline -->
      <h1 class="font-serif text-5xl sm:text-7xl md:text-8xl lg:text-[5.75rem] font-medium tracking-tight text-carbon-900 leading-[0.94]">
        Unbound in curiosity.<br />
        <span class="italic font-light text-burnt-600">Disciplined</span> in execution.
      </h1>

      <!-- High-Signal Introduction -->
      <p class="text-xl sm:text-2xl text-graphite-700 font-light leading-relaxed max-w-2xl font-sans pt-2">
        U.S. Army Officer. McCombs MBA. Brand strategist. Operating at the intersection of operational rigor, business architecture, and cultural discernment.
      </p>

      <!-- Minimalist Navigation Anchors -->
      <div class="pt-4 flex flex-wrap items-center gap-6 text-xs font-mono uppercase tracking-widest">
        <a
          href="/about"
          class="text-carbon-900 hover:text-burnt-600 font-semibold inline-flex items-center gap-1.5 group"
        >
          <span>About Me</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
        <span class="text-bone-400">/</span>
        <a
          href="/timeline"
          class="text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Career Timeline
        </a>
        <span class="text-bone-400">/</span>
        <a
          href="/projects"
          class="text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Selected Work
        </a>
        <span class="text-bone-400">/</span>
        <a
          href="/interests"
          class="text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          The Studio Wall
        </a>
      </div>
    </div>
  </section>

  <!-- Continuous Running Ticker Tape -->
  <section class="my-4">
    <ProjectTicker />
  </section>

  <!-- 02. The Core Narrative & Quick-Scan Ledger (Container-Free Two Columns) -->
  <section class="max-w-7xl mx-auto px-6 sm:px-8 py-20 border-b border-bone-300">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      <!-- Left Column: Perspective -->
      <div class="lg:col-span-6 space-y-6">
        <span class="text-[10px] font-mono uppercase tracking-widest text-graphite-500 block">
          01 // Perspective & Thesis
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-medium tracking-tight text-carbon-900 leading-snug">
          My experience establishes credibility.<br class="hidden sm:inline" />
          My perspective establishes differentiation.
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-graphite-700 leading-relaxed font-sans font-light">
          <p>
            My background doesn't fit into a corporate template. Leading troops as a U.S. Army Officer builds operational stamina, mission clarity, and high-velocity decision-making under uncertainty.
          </p>
          <p>
            Earning my MBA at UT Austin's McCombs School of Business and working on brand strategy for iconic names like Jim Beam and YETI research paired that operational engine with market rigor, consumer psychology, and brand architecture.
          </p>
          <p>
            I treat personal taste not as decoration, but as business intelligence. It is the sensory filter through which enduring products, cultural shifts, and commercial opportunities are recognized.
          </p>
        </div>
        <div class="pt-2">
          <a
            href="/about"
            class="text-xs font-mono uppercase tracking-widest text-burnt-600 hover:text-burnt-700 font-semibold inline-flex items-center gap-2 group"
          >
            <span>Read Full Background & Principles</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Career Ledger (No Boxes, Pure Swiss Ledger) -->
      <div class="lg:col-span-6 space-y-6">
        <span class="text-[10px] font-mono uppercase tracking-widest text-graphite-500 block">
          02 // Career Trajectory &bull; 90-Sec Scan
        </span>
        <div class="divide-y divide-bone-300 border-y border-bone-300">
          <!-- Row 1 -->
          <div class="py-5 space-y-1 group">
            <div class="flex items-baseline justify-between text-xs font-mono text-graphite-500">
              <span class="text-burnt-600 font-semibold">2024 — PRESENT</span>
              <span>AUSTIN, TX</span>
            </div>
            <h3 class="font-serif text-xl font-medium text-carbon-900 group-hover:text-burnt-600 transition-colors">
              Brand Strategist & Strategic Advisor
            </h3>
            <p class="text-xs text-graphite-600 leading-relaxed font-sans">
              Advising consumer brands on occasion-based positioning, category elasticity, and cultural relevance.
            </p>
          </div>

          <!-- Row 2 -->
          <div class="py-5 space-y-1 group">
            <div class="flex items-baseline justify-between text-xs font-mono text-graphite-500">
              <span class="text-burnt-600 font-semibold">2022 — 2024</span>
              <span>AUSTIN, TX</span>
            </div>
            <h3 class="font-serif text-xl font-medium text-carbon-900 group-hover:text-burnt-600 transition-colors">
              Master of Business Administration (MBA)
            </h3>
            <p class="text-xs text-graphite-600 leading-relaxed font-sans">
              The University of Texas at Austin, McCombs School of Business. Concentration in Brand Management & Marketing Strategy.
            </p>
          </div>

          <!-- Row 3 -->
          <div class="py-5 space-y-1 group">
            <div class="flex items-baseline justify-between text-xs font-mono text-graphite-500">
              <span class="text-burnt-600 font-semibold">2017 — 2022</span>
              <span>OPERATIONAL COMMANDS</span>
            </div>
            <h3 class="font-serif text-xl font-medium text-carbon-900 group-hover:text-burnt-600 transition-colors">
              Commissioned Officer, U.S. Army
            </h3>
            <p class="text-xs text-graphite-600 leading-relaxed font-sans">
              Decentralized mission command, multi-million dollar equipment logistics, and leadership under pressure.
            </p>
          </div>
        </div>
        <div>
          <a
            href="/timeline"
            class="text-xs font-mono uppercase tracking-widest text-carbon-900 hover:text-burnt-600 font-semibold inline-flex items-center gap-2 group"
          >
            <span>View Complete Career Timeline</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 03. Selected Work (Magazine Style Spread) -->
  <section class="max-w-7xl mx-auto px-6 sm:px-8 py-20 border-b border-bone-300">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div class="space-y-1">
        <span class="text-[10px] font-mono uppercase tracking-widest text-graphite-500 block">
          03 // Selected Work
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-medium tracking-tight text-carbon-900">
          Strategic Projects & Case Studies
        </h2>
      </div>
      <a
        href="/projects"
        class="text-xs font-mono uppercase tracking-widest text-carbon-900 hover:text-burnt-600 font-semibold inline-flex items-center gap-1.5 group"
      >
        <span>View all 4 case studies</span>
        <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>

    <!-- Editorial List (Container-Free) -->
    <div class="divide-y divide-bone-300 border-t border-bone-300">
      {selectedProjects.map((p, idx) => (
        <article class="py-10 group grid grid-cols-1 md:grid-cols-12 gap-6 items-baseline">
          <!-- Col 1: Index & Category -->
          <div class="md:col-span-3 space-y-1">
            <span class="text-xs font-mono text-burnt-600 font-bold block">
              CASE 0{idx + 1}
            </span>
            <span class="text-[11px] font-mono uppercase tracking-wider text-graphite-500 block">
              {p.clientCategory}
            </span>
          </div>

          <!-- Col 2: Title & Tagline -->
          <div class="md:col-span-6 space-y-2">
            <h3 class="font-serif text-2xl sm:text-3xl font-medium text-carbon-900 group-hover:text-burnt-600 transition-colors">
              <a href="/projects">{p.title}</a>
            </h3>
            <p class="text-xs sm:text-sm text-graphite-600 leading-relaxed font-sans font-light">
              {p.tagline}
            </p>
          </div>

          <!-- Col 3: Role & Link -->
          <div class="md:col-span-3 md:text-right flex md:flex-col justify-between items-baseline md:items-end gap-2">
            <span class="text-xs font-mono text-graphite-500">{p.period}</span>
            <a
              href="/projects"
              class="text-xs font-mono uppercase tracking-widest text-burnt-600 font-semibold group-hover:underline inline-flex items-center gap-1"
            >
              <span>Examine</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 04. The Studio Wall (Asymmetric Contact Sheet) -->
  <section class="max-w-7xl mx-auto px-6 sm:px-8 py-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div class="space-y-1">
        <span class="text-[10px] font-mono uppercase tracking-widest text-graphite-500 block">
          04 // The Studio Wall
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-medium tracking-tight text-carbon-900">
          A Curated Archive of Taste
        </h2>
        <p class="text-xs sm:text-sm text-graphite-600 font-light max-w-xl font-sans mt-1">
          Inspired by creative home office backdrops and collector archives. Footwear, typography, objects, and landscapes that reflect my personal judgment.
        </p>
      </div>
      <a
        href="/interests"
        class="text-xs font-mono uppercase tracking-widest text-carbon-900 hover:text-burnt-600 font-semibold inline-flex items-center gap-1.5 group"
      >
        <span>Explore entire wall</span>
        <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>

    <!-- Asymmetric Editorial Gallery -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <!-- Item 1: Wide focus -->
      <div class="md:col-span-7 space-y-3 group">
        <div class="aspect-[16/10] w-full overflow-hidden bg-bone-200 border border-bone-300">
          <img
            src={previewArtifacts[0].image}
            alt={previewArtifacts[0].title}
            class="w-full h-full object-cover grayscale contrast-105 group-hover:grayscale-0 group-hover:scale-[1.02] transition-all duration-500"
            loading="lazy"
          />
        </div>
        <div class="flex items-baseline justify-between text-xs font-mono pt-1">
          <span class="font-serif text-lg font-medium text-carbon-900 group-hover:text-burnt-600 transition-colors">
            {previewArtifacts[0].title}
          </span>
          <span class="text-graphite-500 uppercase tracking-widest text-[10px]">
            {previewArtifacts[0].categoryLabel}
          </span>
        </div>
        <p class="text-xs text-graphite-600 font-sans font-light leading-relaxed">
          "{previewArtifacts[0].note}"
        </p>
      </div>

      <!-- Item 2 & 3: Stacked side -->
      <div class="md:col-span-5 space-y-10">
        {previewArtifacts.slice(1, 3).map((item) => (
          <div class="space-y-3 group">
            <div class="aspect-[4/3] w-full overflow-hidden bg-bone-200 border border-bone-300">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover grayscale contrast-105 group-hover:grayscale-0 group-hover:scale-[1.02] transition-all duration-500"
                loading="lazy"
              />
            </div>
            <div class="flex items-baseline justify-between text-xs font-mono pt-1">
              <span class="font-serif text-base font-medium text-carbon-900 group-hover:text-burnt-600 transition-colors">
                {item.title}
              </span>
              <span class="text-graphite-500 uppercase tracking-widest text-[10px]">
                {item.categoryLabel}
              </span>
            </div>
            <p class="text-xs text-graphite-600 font-sans font-light leading-relaxed">
              "{item.note}"
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
