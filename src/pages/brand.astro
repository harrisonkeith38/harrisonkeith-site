---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import LockupSide from '../components/LockupSide.astro';

const colors = [
  { name: 'Carbon', hex: '#141414', use: 'Type and structure' },
  { name: 'Concrete', hex: '#A6A6A6', use: 'Rules and dividers' },
  { name: 'Chalk', hex: '#F4F4F4', use: 'Canvas and space' },
  { name: 'Signal Yellow', hex: '#E4BD25' },
  { name: 'Racing Red', hex: '#B74438' },
  { name: 'Alpine Blue', hex: '#438CA9' },
];
const type = [
  { face: 'Panchang', role: 'Headlines', cls: 'font-display font-extrabold uppercase text-2xl sm:text-3xl' },
  { face: 'General Sans', role: 'Body copy', cls: 'font-sans text-2xl sm:text-3xl' },
  { face: 'Martian Mono', role: 'Labels and data', cls: 'font-technical uppercase text-lg sm:text-xl' },
];
const materials = [
  { name: 'Matte metal', file: 'matte-metal-subtle.svg' },
  { name: 'Brushed aluminum', file: 'brushed-aluminum-subtle.svg' },
  { name: 'Graphite', file: 'graphite-subtle.svg' },
];
const icons = [
  { name: 'Arrow', file: 'arrow-up-right.svg' },
  { name: 'Grid', file: 'grid.svg' },
  { name: 'Signal', file: 'signal.svg' },
];
const h2 = 'font-display font-bold text-xl uppercase border-t border-carbon pt-5 mb-6';
---

<Layout title="Brand | HARRISON KEITH">
  <div class="max-w-6xl mx-auto w-full px-6 pt-14 space-y-16">
    <PageHeading
      title="Brand"
      intro="I love brands and branding. I have always been drawn to fonts, style and the way a brand communicates and shows up, and I like getting into those details. This page is how I have applied that to my own."
    />

    <section>
      <h2 class={h2}>Logo</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <figure class="bg-chalk border border-concrete p-5 flex flex-col gap-4">
          <figcaption class="font-technical text-[10px] uppercase font-bold">Mark</figcaption>
          <div class="flex-1 flex items-center justify-center min-h-[220px]">
            <img src="/brand/hk-mark.png" alt="HK mark" width="456" height="182" class="w-full max-w-[340px] h-auto" />
          </div>
        </figure>
        <figure class="bg-chalk border border-concrete p-5 flex flex-col gap-4">
          <figcaption class="font-technical text-[10px] uppercase font-bold">Wordmark</figcaption>
          <div class="flex-1 flex items-center justify-center min-h-[220px]">
            <img src="/brand/hk-wordmark.png" alt="Harrison Keith wordmark" width="847" height="46" class="w-full h-auto" />
          </div>
        </figure>
        <figure class="bg-chalk border border-concrete p-5 flex flex-col gap-4">
          <figcaption class="font-technical text-[10px] uppercase font-bold">Stacked lockup</figcaption>
          <div class="flex-1 flex items-center justify-center min-h-[220px]">
            <img src="/brand/hk-lockup.png" alt="Stacked lockup: HK mark, name and stripes" width="847" height="321" class="w-full max-w-[400px] h-auto" />
          </div>
        </figure>
        <figure class="bg-chalk border border-concrete p-5 flex flex-col gap-4">
          <figcaption class="font-technical text-[10px] uppercase font-bold">Side-by-side lockup</figcaption>
          <div class="flex-1 flex items-center justify-center min-h-[220px]">
            <div role="img" aria-label="Side-by-side lockup: HK mark beside the name and stripes" class="w-full">
              <LockupSide fluid />
            </div>
          </div>
        </figure>
      </div>
    </section>

    <section>
      <h2 class={h2}>Color</h2>
      <ul class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {colors.map((c) => (
          <li class="bg-chalk border border-concrete">
            <div class="h-28" style={`background:${c.hex}`} />
            <div class="p-4 space-y-1">
              <p class="font-bold">{c.name}</p>
              <p class="font-technical text-[10px]">{c.hex}</p>
              {'use' in c && <p class="text-sm">{c.use}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class={h2}>Type</h2>
      <ul class="space-y-4">
        {type.map((t) => (
          <li class="bg-chalk border border-concrete p-6 space-y-3 overflow-hidden">
            <p class="font-technical text-[10px] uppercase">{t.role}: {t.face}</p>
            <p class={t.cls}>Harrison Keith</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class={h2}>Materials</h2>
      <ul class="grid gap-4 sm:grid-cols-3">
        {materials.map((m) => (
          <li class="bg-chalk border border-concrete">
            <img src={`/brand/kit/${m.file}`} alt="" width="800" height="800" loading="lazy" class="w-full h-48 object-cover" />
            <p class="font-technical text-[10px] uppercase font-bold p-4">{m.name}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class={h2}>Topography</h2>
      <div class="bg-chalk border border-concrete">
        <img src="/brand/kit/topography-display.svg" alt="Topographic contour lines" width="1600" height="1200" loading="lazy" class="w-full h-72 sm:h-96 object-cover" />
      </div>
    </section>

    <section>
      <h2 class={h2}>Icons</h2>
      <ul class="grid grid-cols-3 gap-4">
        {icons.map((i) => (
          <li class="bg-chalk border border-concrete flex flex-col items-center">
            <img src={`/brand/kit/${i.file}`} alt="" width="48" height="48" loading="lazy" class="w-16 h-16 mt-8 mb-4" />
            <p class="font-technical text-[10px] uppercase font-bold p-4">{i.name}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
