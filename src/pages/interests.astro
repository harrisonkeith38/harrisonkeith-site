---
import Layout from '../layouts/Layout.astro';
import { artifacts } from '../data/interests';
---

<Layout
  title="My Interests — The Studio Wall — Harrison Keith"
  description="Curated gallery and studio backdrop of personal taste, design influences, footwear, typography, and endurance culture."
>
  <div class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header -->
    <div class="space-y-4 pb-12 border-b border-bone-300">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-burnt-600 font-semibold">
        <span>04 // The Studio Wall & Cultural Archive</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-medium tracking-tight text-carbon-900 leading-tight">
        A Curated Archive of Taste & Influence
      </h1>
      <p class="text-base text-graphite-600 max-w-2xl font-normal leading-relaxed">
        Inspired by the backdrop of a creative home studio—a living collection of footwear, typography, industrial objects, identity systems, and landscapes that reflect my personal judgment and aesthetic standards.
      </p>

      <!-- Category Filter Buttons -->
      <div class="pt-6 flex flex-wrap gap-2" id="artifact-filters">
        <button
          data-filter="all"
          class="art-filter-btn active px-3.5 py-1.5 rounded-sm text-xs font-mono uppercase tracking-wider bg-carbon-900 text-bone-50 transition-all"
        >
          All Artifacts ({artifacts.length})
        </button>
        <button
          data-filter="footwear"
          class="art-filter-btn px-3.5 py-1.5 rounded-sm text-xs font-mono uppercase tracking-wider bg-bone-200 text-carbon-800 hover:bg-bone-300 transition-all"
        >
          Footwear
        </button>
        <button
          data-filter="identity"
          class="art-filter-btn px-3.5 py-1.5 rounded-sm text-xs font-mono uppercase tracking-wider bg-bone-200 text-carbon-800 hover:bg-bone-300 transition-all"
        >
          Logos & Identity
        </button>
        <button
          data-filter="typography"
          class="art-filter-btn px-3.5 py-1.5 rounded-sm text-xs font-mono uppercase tracking-wider bg-bone-200 text-carbon-800 hover:bg-bone-300 transition-all"
        >
          Typography
        </button>
        <button
          data-filter="objects"
          class="art-filter-btn px-3.5 py-1.5 rounded-sm text-xs font-mono uppercase tracking-wider bg-bone-200 text-carbon-800 hover:bg-bone-300 transition-all"
        >
          Industrial Design
        </button>
        <button
          data-filter="spaces"
          class="art-filter-btn px-3.5 py-1.5 rounded-sm text-xs font-mono uppercase tracking-wider bg-bone-200 text-carbon-800 hover:bg-bone-300 transition-all"
        >
          Spaces & Topography
        </button>
        <button
          data-filter="endurance"
          class="art-filter-btn px-3.5 py-1.5 rounded-sm text-xs font-mono uppercase tracking-wider bg-bone-200 text-carbon-800 hover:bg-bone-300 transition-all"
        >
          Endurance
        </button>
      </div>
    </div>

    <!-- The Gallery Wall Grid -->
    <div class="py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="artifacts-grid">
      {artifacts.map((item) => (
        <article
          class="artifact-card bg-bone-50 border border-bone-300 rounded-sm overflow-hidden flex flex-col justify-between hover:border-carbon-800 hover:shadow-md transition-all group"
          data-category={item.category}
        >
          <!-- Image Container -->
          <div class="aspect-[4/3] w-full overflow-hidden bg-bone-200 relative">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-300"
              loading="lazy"
            />
            <div class="absolute top-3 right-3 bg-carbon-900/80 backdrop-blur-sm text-bone-100 text-[10px] font-mono uppercase px-2.5 py-0.5 rounded">
              {item.categoryLabel}
            </div>
            {item.year && (
              <div class="absolute bottom-3 left-3 bg-bone-100/90 backdrop-blur-sm text-carbon-900 text-[10px] font-mono px-2 py-0.5 rounded border border-bone-300">
                {item.year}
              </div>
            )}
          </div>

          <!-- Card Body -->
          <div class="p-6 flex flex-col justify-between flex-grow space-y-4">
            <div class="space-y-1">
              <span class="text-[11px] font-mono uppercase tracking-wider text-burnt-600 block">
                {item.source}
              </span>
              <h2 class="font-serif text-2xl font-medium text-carbon-900 group-hover:text-burnt-600 transition-colors leading-snug">
                {item.title}
              </h2>
            </div>

            <!-- Punchy Commentary -->
            <p class="text-xs text-graphite-700 leading-relaxed font-sans pt-2 border-t border-bone-200">
              "{item.note}"
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Curator Note -->
    <div class="border-t border-bone-300 pt-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 text-xs font-mono text-graphite-600">
      <div>
        <span class="font-semibold text-carbon-900">Curator Note:</span> This wall evolves continuously with new field photography, research, and acquired references.
      </div>
      <div>
        Total Indexed Items: <span class="font-bold text-carbon-900">{artifacts.length}</span>
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.art-filter-btn');
  const artifactCards = document.querySelectorAll('.artifact-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'bg-carbon-900', 'text-bone-50');
        b.classList.add('bg-bone-200', 'text-carbon-800');
      });

      btn.classList.remove('bg-bone-200', 'text-carbon-800');
      btn.classList.add('active', 'bg-carbon-900', 'text-bone-50');

      const filter = btn.getAttribute('data-filter');

      artifactCards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
