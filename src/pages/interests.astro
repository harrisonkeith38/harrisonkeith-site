---
import Layout from '../layouts/Layout.astro';
import { artifacts, currentlyObsessed, enduranceProfile } from '../data/interests';
---

<Layout
  title="The Studio Wall & Interests — HARRISON KEITH"
  description="Curated visual archive of footwear, industrial design, typography, endurance athletics, and culture."
>
  <div class="max-w-6xl mx-auto px-6 py-16 sm:py-20 space-y-24">
    <!-- Header -->
    <header class="space-y-4 pb-12 border-b border-concrete/30">
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1">
          <span class="w-2.5 h-[3px] bg-signalYellow transform -skew-x-12 inline-block"></span>
          <span class="w-2.5 h-[3px] bg-racingRed transform -skew-x-12 inline-block"></span>
          <span class="w-2.5 h-[3px] bg-alpineBlue transform -skew-x-12 inline-block"></span>
        </div>
        <span class="text-xs font-technical uppercase tracking-extended text-concrete">
          CURATION // VISUAL CULTURE & TASTE
        </span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-carbon uppercase tracking-tight">
        The Studio Wall & Influences
      </h1>
      <p class="text-sm font-sans text-carbon/80 max-w-xl leading-relaxed">
        An archive of design objects, footwear engineering, identity systems, and endurance pursuits that shape how I recognize quality and consumer behavior.
      </p>

      <!-- Category Filter Links -->
      <div class="pt-6 flex flex-wrap items-center gap-4 text-xs font-technical uppercase tracking-extended" id="artifact-filters">
        <button
          data-filter="all"
          class="art-filter-btn active text-carbon font-bold border-b border-carbon pb-0.5 transition-colors"
        >
          All Items ({artifacts.length})
        </button>
        <span class="text-concrete/40">/</span>
        <button
          data-filter="footwear"
          class="art-filter-btn text-concrete hover:text-carbon transition-colors"
        >
          Footwear
        </button>
        <span class="text-concrete/40">/</span>
        <button
          data-filter="identity"
          class="art-filter-btn text-concrete hover:text-carbon transition-colors"
        >
          Logos & Identity
        </button>
        <span class="text-concrete/40">/</span>
        <button
          data-filter="architecture"
          class="art-filter-btn text-concrete hover:text-carbon transition-colors"
        >
          Architecture
        </button>
        <span class="text-concrete/40">/</span>
        <button
          data-filter="endurance"
          class="art-filter-btn text-concrete hover:text-carbon transition-colors"
        >
          Endurance
        </button>
        <span class="text-concrete/40">/</span>
        <button
          data-filter="design"
          class="art-filter-btn text-concrete hover:text-carbon transition-colors"
        >
          Design
        </button>
      </div>
    </header>

    <!-- 01. The Visual Gallery Wall Grid -->
    <section class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="artifacts-grid">
        {artifacts.map((item, idx) => (
          <article
            class="artifact-item space-y-3 group"
            data-category={item.category}
          >
            <!-- Image Frame with Concrete Hairline -->
            <div class="aspect-[4/3] w-full overflow-hidden bg-chalk border border-concrete/40 relative">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 transition-all duration-300"
                loading="lazy"
              />
              <div class="absolute top-2 right-2 bg-carbon text-chalk text-[9px] font-technical uppercase tracking-widest px-2 py-0.5">
                {item.categoryLabel}
              </div>
              <div class="absolute bottom-2 left-2 text-chalk/90 text-[10px] font-technical tracking-widest bg-carbon/80 px-1.5 py-0.5">
                FIG. 0{idx + 1}
              </div>
            </div>

            <!-- Title & Punchy Curator Commentary -->
            <div class="space-y-1">
              <div class="flex items-baseline justify-between text-[10px] font-technical text-concrete uppercase tracking-wider">
                <span>{item.source}</span>
                {item.year && <span>{item.year}</span>}
              </div>
              <h2 class="font-display font-bold text-lg text-carbon uppercase tracking-wide group-hover:text-racingRed transition-colors">
                {item.title}
              </h2>
              <p class="text-xs font-sans text-carbon/75 font-light leading-relaxed pt-1">
                "{item.note}"
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 02. Dedicated Endurance Athletics Section -->
    <section class="space-y-8 border-t border-concrete/30 pt-16">
      <div class="border-b border-concrete/30 pb-4">
        <span class="text-xs font-technical uppercase tracking-extended text-concrete block">
          02 // PURSUITS & DISCIPLINE
        </span>
        <h2 class="font-display font-bold text-xl text-carbon uppercase tracking-wide">
          Endurance Athletics & Testing
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {enduranceProfile.map((ep) => (
          <div class="border border-concrete/40 p-8 space-y-4 bg-chalk">
            <span class="text-[10px] font-technical uppercase tracking-extended text-racingRed font-bold block">
              DISCIPLINE FOCUS
            </span>
            <h3 class="font-display font-bold text-xl text-carbon uppercase tracking-tight">
              {ep.discipline}
            </h3>
            <div class="space-y-1 text-xs font-technical text-concrete uppercase">
              <div><strong>Focus:</strong> {ep.focus}</div>
              <div><strong>Primary Terrain:</strong> {ep.terrain}</div>
            </div>
            <p class="text-xs font-sans text-carbon/80 leading-relaxed pt-2 border-t border-concrete/20">
              "{ep.notes}"
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- 03. Currently Obsessed / Reading / Listening / Gear in Test -->
    <section class="space-y-8 border-t border-concrete/30 pt-16">
      <div class="border-b border-concrete/30 pb-4">
        <span class="text-xs font-technical uppercase tracking-extended text-concrete block">
          03 // IN ROTATION
        </span>
        <h2 class="font-display font-bold text-xl text-carbon uppercase tracking-wide">
          Currently Obsessed / Reading / Listening
        </h2>
      </div>

      <div class="divide-y divide-concrete/30">
        {currentlyObsessed.map((item) => (
          <div class="py-5 grid grid-cols-1 sm:grid-cols-12 gap-3 items-baseline text-xs font-technical">
            <div class="sm:col-span-3 text-concrete uppercase tracking-wider font-bold">
              [{item.category}]
            </div>
            <div class="sm:col-span-4 font-display font-bold text-carbon text-sm uppercase tracking-wide">
              {item.title}
              <span class="block text-xs font-sans text-concrete font-normal normal-case mt-0.5">
                by {item.authorOrBrand}
              </span>
            </div>
            <div class="sm:col-span-5 font-sans text-xs text-carbon/80 font-light leading-relaxed">
              {item.oneLiner}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.art-filter-btn');
  const artifactItems = document.querySelectorAll('.artifact-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'text-carbon', 'font-bold', 'border-b', 'border-carbon');
        b.classList.add('text-concrete');
      });

      btn.classList.remove('text-concrete');
      btn.classList.add('active', 'text-carbon', 'font-bold', 'border-b', 'border-carbon');

      const filter = btn.getAttribute('data-filter');

      artifactItems.forEach((item) => {
        const cat = item.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
