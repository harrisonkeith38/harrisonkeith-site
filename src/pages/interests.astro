---
import Layout from '../layouts/Layout.astro';
import { artifacts } from '../data/interests';
---

<Layout
  title="My Interests — The Studio Wall — Harrison Keith"
  description="Curated gallery and studio backdrop of personal taste, design influences, footwear, typography, and endurance culture."
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 py-20">
    <!-- Header -->
    <header class="space-y-6 pb-16 border-b border-bone-300">
      <div class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-widest text-graphite-500">
        <span class="w-1.5 h-1.5 rounded-full bg-burnt-600"></span>
        <span>04 // The Studio Wall & Cultural Archive</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-medium tracking-tight text-carbon-900 leading-[1.02]">
        A Living Archive of Taste & Influence
      </h1>
      <p class="text-lg sm:text-xl text-graphite-600 font-light leading-relaxed max-w-2xl font-sans">
        Inspired by creative home office backdrops and design archives. An intentional curation of footwear, typography, industrial objects, identity systems, and topography that trains my intuition.
      </p>

      <!-- Category Filter Links -->
      <div class="pt-6 flex flex-wrap items-center gap-4 text-xs font-mono uppercase tracking-widest" id="artifact-filters">
        <button
          data-filter="all"
          class="art-filter-link active text-burnt-600 font-bold transition-colors"
        >
          All Items ({artifacts.length})
        </button>
        <span class="text-bone-400">/</span>
        <button
          data-filter="footwear"
          class="art-filter-link text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Footwear
        </button>
        <span class="text-bone-400">/</span>
        <button
          data-filter="identity"
          class="art-filter-link text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Logos & Identity
        </button>
        <span class="text-bone-400">/</span>
        <button
          data-filter="typography"
          class="art-filter-link text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Typography
        </button>
        <span class="text-bone-400">/</span>
        <button
          data-filter="objects"
          class="art-filter-link text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Industrial Design
        </button>
        <span class="text-bone-400">/</span>
        <button
          data-filter="spaces"
          class="art-filter-link text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Topography
        </button>
        <span class="text-bone-400">/</span>
        <button
          data-filter="endurance"
          class="art-filter-link text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Endurance
        </button>
      </div>
    </header>

    <!-- The Studio Gallery Grid (Asymmetric Editorial Layout, No Box Cards) -->
    <div class="py-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-16 border-b border-bone-300" id="artifacts-grid">
      {artifacts.map((item, idx) => (
        <article
          class="artifact-item space-y-4 group"
          data-category={item.category}
        >
          <!-- Image Frame with Hairline Border -->
          <div class="aspect-[4/3] w-full overflow-hidden bg-bone-200 border border-bone-300 relative">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover grayscale contrast-105 group-hover:grayscale-0 group-hover:scale-[1.03] transition-all duration-500"
              loading="lazy"
            />
            <div class="absolute top-2.5 right-2.5 bg-carbon-900/80 backdrop-blur-sm text-bone-100 text-[9px] font-mono uppercase tracking-widest px-2 py-0.5">
              {item.categoryLabel}
            </div>
            <div class="absolute bottom-2.5 left-2.5 text-bone-100/90 text-[10px] font-mono tracking-widest">
              FIG. 0{idx + 1}
            </div>
          </div>

          <!-- Museum Caption -->
          <div class="space-y-1.5 pt-1">
            <div class="flex items-baseline justify-between text-[11px] font-mono text-graphite-500">
              <span class="text-burnt-600 font-semibold">{item.source}</span>
              {item.year && <span>{item.year}</span>}
            </div>
            <h2 class="font-serif text-2xl font-medium text-carbon-900 group-hover:text-burnt-600 transition-colors leading-snug">
              {item.title}
            </h2>
            <p class="text-xs text-graphite-600 font-sans font-light leading-relaxed pt-1">
              "{item.note}"
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Curator Colophon -->
    <div class="pt-12 flex flex-col sm:flex-row items-baseline justify-between gap-6 text-xs font-mono text-graphite-500">
      <div>
        <span>INDEX COUNT:</span> <strong class="text-carbon-900">{artifacts.length} ARTIFACTS</strong> &bull; Curated and updated regularly
      </div>
      <div>
        <a href="/connect" class="text-burnt-600 hover:text-burnt-700 font-semibold uppercase tracking-widest">Inquire / Suggest an Artifact &rarr;</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterLinks = document.querySelectorAll('.art-filter-link');
  const artifactItems = document.querySelectorAll('.artifact-item');

  filterLinks.forEach((link) => {
    link.addEventListener('click', () => {
      filterLinks.forEach((l) => {
        l.classList.remove('active', 'text-burnt-600', 'font-bold');
        l.classList.add('text-carbon-800');
      });

      link.classList.remove('text-carbon-800');
      link.classList.add('active', 'text-burnt-600', 'font-bold');

      const filter = link.getAttribute('data-filter');

      artifactItems.forEach((item) => {
        const cat = item.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
