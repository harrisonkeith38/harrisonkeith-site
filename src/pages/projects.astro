---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
---

<Layout
  title="My Projects — Harrison Keith"
  description="Strategic case studies, brand architecture, consumer research, and operational execution."
>
  <div class="max-w-6xl mx-auto px-6 sm:px-8 py-20">
    <!-- Header -->
    <header class="space-y-6 pb-16 border-b border-bone-300">
      <div class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-widest text-graphite-500">
        <span class="w-1.5 h-1.5 rounded-full bg-burnt-600"></span>
        <span>03 // Selected Strategic Work</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-medium tracking-tight text-carbon-900 leading-[1.02]">
        Strategic Case Studies & Deliverables
      </h1>
      <p class="text-lg sm:text-xl text-graphite-600 font-light leading-relaxed max-w-2xl font-sans">
        To preserve non-disclosure commitments and proprietary client data, these case studies highlight strategic framing, methodology, decision frameworks, and impact.
      </p>

      <!-- Minimalist Filter Bar -->
      <div class="pt-6 flex flex-wrap items-center gap-4 text-xs font-mono uppercase tracking-widest" id="filter-container">
        <button
          data-filter="all"
          class="filter-link active text-burnt-600 font-bold transition-colors"
        >
          All Work ({projects.length})
        </button>
        <span class="text-bone-400">/</span>
        <button
          data-filter="Brand Strategy"
          class="filter-link text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Brand Strategy
        </button>
        <span class="text-bone-400">/</span>
        <button
          data-filter="Consumer Insights"
          class="filter-link text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Consumer Insights
        </button>
        <span class="text-bone-400">/</span>
        <button
          data-filter="Operational Leadership"
          class="filter-link text-carbon-800 hover:text-burnt-600 transition-colors"
        >
          Operational Leadership
        </button>
      </div>
    </header>

    <!-- Case Studies List (Container-Free Editorial Spread) -->
    <div class="divide-y divide-bone-300 border-b border-bone-300" id="projects-grid">
      {projects.map((p, idx) => (
        <article
          class="project-item py-16 space-y-10 group"
          data-tags={JSON.stringify(p.tags)}
        >
          <!-- Masthead Row -->
          <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-4">
            <div class="space-y-1">
              <span class="text-xs font-mono text-burnt-600 font-bold tracking-widest block">
                CASE 0{idx + 1} &bull; {p.clientCategory}
              </span>
              <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-medium text-carbon-900 group-hover:text-burnt-600 transition-colors">
                {p.title}
              </h2>
            </div>
            <div class="text-xs font-mono text-graphite-500 md:text-right">
              <div>{p.period}</div>
              <div class="text-carbon-800 font-medium">{p.role}</div>
            </div>
          </div>

          <!-- Editorial Tagline -->
          <p class="font-serif italic text-xl sm:text-2xl text-carbon-800 leading-snug max-w-4xl font-normal">
            "{p.tagline}"
          </p>

          <!-- 3-Column Breakdown (Clean Grid, No Container Boxes) -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-4 border-t border-bone-200">
            <!-- Col 1: Problem -->
            <div class="space-y-2">
              <span class="text-[10px] font-mono uppercase tracking-widest text-graphite-500 block">
                [01] Strategic Challenge
              </span>
              <p class="text-xs sm:text-sm text-graphite-700 leading-relaxed font-sans font-light">
                {p.challenge}
              </p>
            </div>

            <!-- Col 2: Insight -->
            <div class="space-y-2">
              <span class="text-[10px] font-mono uppercase tracking-widest text-graphite-500 block">
                [02] Core Insight
              </span>
              <p class="text-xs sm:text-sm text-graphite-700 leading-relaxed font-sans font-light">
                {p.insight}
              </p>
            </div>

            <!-- Col 3: Strategy & Impact -->
            <div class="space-y-2">
              <span class="text-[10px] font-mono uppercase tracking-widest text-graphite-500 block">
                [03] Execution & Business Value
              </span>
              <p class="text-xs sm:text-sm text-graphite-700 leading-relaxed font-sans font-light">
                {p.impact}
              </p>
            </div>
          </div>

          <!-- Bottom: Takeaway & Tags -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-mono pt-4 text-graphite-500">
            <div>
              <span class="text-carbon-900 font-medium">Core Reflection:</span> {p.reflection}
            </div>
            <div class="flex flex-wrap gap-2">
              {p.tags.map((tag) => (
                <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 bg-bone-200 text-carbon-800 rounded-sm">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Next Page Anchor -->
    <div class="pt-12 flex flex-col sm:flex-row items-baseline justify-between gap-6 text-xs font-mono">
      <div class="text-graphite-500 uppercase tracking-widest">
        Next: <a href="/interests" class="text-burnt-600 hover:text-burnt-700 font-semibold ml-1">Explore The Studio Wall &rarr;</a>
      </div>
      <div>
        <a href="/connect" class="text-carbon-900 hover:text-burnt-600 transition-colors uppercase tracking-widest">Direct Inquiries &rarr;</a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const filterLinks = document.querySelectorAll('.filter-link');
  const projectItems = document.querySelectorAll('.project-item');

  filterLinks.forEach((link) => {
    link.addEventListener('click', () => {
      filterLinks.forEach((l) => {
        l.classList.remove('active', 'text-burnt-600', 'font-bold');
        l.classList.add('text-carbon-800');
      });

      link.classList.remove('text-carbon-800');
      link.classList.add('active', 'text-burnt-600', 'font-bold');

      const filter = link.getAttribute('data-filter');

      projectItems.forEach((item) => {
        if (filter === 'all') {
          (item as HTMLElement).style.display = 'block';
        } else {
          const tags = JSON.parse(item.getAttribute('data-tags') || '[]');
          if (tags.includes(filter)) {
            (item as HTMLElement).style.display = 'block';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        }
      });
    });
  });
</script>
