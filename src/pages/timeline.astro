---
import Layout from '../layouts/Layout.astro';
import { detailedTimeline, credentials } from '../data/timeline';
---

<Layout
  title="Career Timeline — HARRISON KEITH"
  description="Chronological career journey across military leadership, McCombs MBA, and brand marketing strategy."
>
  <div class="max-w-5xl mx-auto px-6 py-16 sm:py-20">
    <!-- Header -->
    <header class="space-y-4 pb-12 border-b border-concrete/30">
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1">
          <span class="w-2.5 h-[3px] bg-signalYellow transform -skew-x-12 inline-block"></span>
          <span class="w-2.5 h-[3px] bg-racingRed transform -skew-x-12 inline-block"></span>
          <span class="w-2.5 h-[3px] bg-alpineBlue transform -skew-x-12 inline-block"></span>
        </div>
        <span class="text-xs font-technical uppercase tracking-extended text-concrete">
          CAREER TIMELINE & SCOPE
        </span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-carbon uppercase tracking-tight">
        Professional Experience & Pedigree
      </h1>

      <div class="pt-2 flex items-center gap-4 text-xs font-technical uppercase tracking-extended">
        <a
          href="/harrison-keith-resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 border border-carbon text-carbon hover:bg-carbon hover:text-chalk transition-colors font-bold inline-flex items-center gap-2"
        >
          <span>Download Official Résumé (PDF)</span>
          <span>&darr;</span>
        </a>
      </div>
    </header>

    <!-- Detailed Timeline List -->
    <div class="py-12 divide-y divide-concrete/30 border-b border-concrete/30">
      {detailedTimeline.map((item) => (
        <article class="py-12 grid grid-cols-1 md:grid-cols-12 gap-6 items-start group">
          <!-- Dates & Location -->
          <div class="md:col-span-3 space-y-1">
            <span class="text-xs font-technical font-bold text-carbon block tracking-wider">
              {item.period}
            </span>
            <span class="text-[11px] font-technical text-concrete uppercase tracking-widest block">
              {item.location}
            </span>
          </div>

          <!-- Role, Organization & Specific Bullets -->
          <div class="md:col-span-9 space-y-4">
            <div>
              <span class="text-[11px] font-technical uppercase tracking-extended text-concrete block mb-1">
                {item.organization}
              </span>
              <h2 class="font-display font-bold text-2xl text-carbon uppercase tracking-tight group-hover:text-racingRed transition-colors">
                {item.role}
              </h2>
            </div>

            <p class="text-sm font-sans text-carbon/80 leading-relaxed">
              {item.summary}
            </p>

            <!-- Specific Impact Bullets -->
            <ul class="space-y-2 pt-2 text-xs sm:text-sm font-sans text-carbon/90">
              {item.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-racingRed font-bold mt-0.5">&bull;</span>
                  <span class="leading-relaxed">{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <!-- Education & Credentials Section -->
    <section class="py-16 space-y-8">
      <div>
        <span class="text-xs font-technical uppercase tracking-extended text-concrete block mb-1">
          CREDENTIALS
        </span>
        <h2 class="font-display font-bold text-2xl text-carbon uppercase tracking-tight">
          Education & Certifications
        </h2>
      </div>

      <div class="divide-y divide-concrete/30 border-t border-concrete/30">
        {credentials.map((cred) => (
          <div class="py-6 grid grid-cols-1 md:grid-cols-12 gap-4 items-baseline text-xs font-technical">
            <div class="md:col-span-3 text-concrete uppercase tracking-wider">
              {cred.year}
            </div>
            <div class="md:col-span-6 font-display font-bold text-carbon text-sm uppercase tracking-wide">
              {cred.institution}
              <span class="block font-sans font-normal text-xs text-carbon/80 lowercase capitalize mt-0.5">
                {cred.degreeOrCert}
              </span>
            </div>
            <div class="md:col-span-3 text-concrete text-[11px] uppercase tracking-wider md:text-right">
              {cred.details}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom Actions -->
    <div class="pt-8 border-t border-concrete/30 flex flex-col sm:flex-row items-baseline justify-between gap-4 text-xs font-technical uppercase tracking-extended">
      <div>
        Next: <a href="/projects" class="text-carbon hover:text-racingRed font-bold ml-1">Explore Projects &rarr;</a>
      </div>
      <div>
        <a href="/harrison-keith-resume.pdf" target="_blank" class="text-carbon hover:text-racingRed font-bold">Download Résumé (PDF) &darr;</a>
      </div>
    </div>
  </div>
</Layout>
