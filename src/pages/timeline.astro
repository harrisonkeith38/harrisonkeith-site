---
import Layout from '../layouts/Layout.astro';
import { timeline } from '../data/timeline';
---

<Layout
  title="Career Timeline — Harrison Keith"
  description="Chronological career journey and milestones across military leadership, McCombs MBA, and brand marketing strategy."
>
  <div class="max-w-5xl mx-auto px-6 sm:px-8 py-20">
    <!-- Header -->
    <header class="space-y-6 pb-16 border-b border-bone-300">
      <div class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-widest text-graphite-500">
        <span class="w-1.5 h-1.5 rounded-full bg-burnt-600"></span>
        <span>02 // Professional Record & Arc</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-medium tracking-tight text-carbon-900 leading-[1.02]">
        Career Timeline & Leadership Arc
      </h1>
      <p class="text-lg sm:text-xl text-graphite-600 font-light leading-relaxed max-w-2xl font-sans">
        A progressive arc connecting operational command, graduate business education, and brand marketing strategy.
      </p>
      <div class="pt-2 text-xs font-mono">
        <a href="/connect" class="text-burnt-600 hover:text-burnt-700 font-semibold uppercase tracking-widest inline-flex items-center gap-1.5 group">
          <span>Request Official Résumé PDF</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>
    </header>

    <!-- Swiss Chronological Ledger (Container-Free) -->
    <div class="py-12 divide-y divide-bone-300 border-b border-bone-300">
      {timeline.map((item, idx) => (
        <article class="py-14 grid grid-cols-1 md:grid-cols-12 gap-8 items-start group">
          <!-- Col 1: Date & Location -->
          <div class="md:col-span-3 space-y-1">
            <span class="text-xs font-mono text-burnt-600 font-bold block tracking-wider">
              {item.period}
            </span>
            <span class="text-[11px] font-mono text-graphite-500 uppercase tracking-widest block">
              {item.location}
            </span>
            <span class="text-[10px] font-mono text-graphite-400 block pt-1">
              EPOCH 0{idx + 1}
            </span>
          </div>

          <!-- Col 2: Role & Narrative Impact -->
          <div class="md:col-span-9 space-y-6">
            <div>
              <span class="text-[11px] font-mono uppercase tracking-widest text-graphite-500 block mb-1">
                {item.organization}
              </span>
              <h2 class="font-serif text-3xl font-medium text-carbon-900 group-hover:text-burnt-600 transition-colors">
                {item.role}
              </h2>
            </div>

            <!-- Summary -->
            <p class="text-base text-graphite-700 font-light leading-relaxed font-sans">
              {item.summary}
            </p>

            <!-- Responsibilities & Scope -->
            <div class="space-y-3 pt-2">
              <span class="text-[10px] font-mono uppercase tracking-widest text-graphite-500 block">
                Scope & Key Execution
              </span>
              <ul class="space-y-2 text-xs sm:text-sm text-graphite-600 font-sans font-light">
                {item.responsibilities.map((resp) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-burnt-600 font-mono mt-0.5">&bull;</span>
                    <span class="leading-relaxed">{resp}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Capabilities Unlocked -->
            <div class="pt-4 flex flex-wrap gap-2">
              {item.capabilitiesUnlocked.map((cap) => (
                <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 bg-bone-200/80 text-carbon-800 rounded-sm">
                  {cap}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Next Page Anchor -->
    <div class="pt-12 flex flex-col sm:flex-row items-baseline justify-between gap-6 text-xs font-mono">
      <div class="text-graphite-500 uppercase tracking-widest">
        Next: <a href="/projects" class="text-burnt-600 hover:text-burnt-700 font-semibold ml-1">Examine Selected Projects &rarr;</a>
      </div>
      <div>
        <a href="/connect" class="text-carbon-900 hover:text-burnt-600 transition-colors uppercase tracking-widest">Direct Inquiries &rarr;</a>
      </div>
    </div>
  </div>
</Layout>
