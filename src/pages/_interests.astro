---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { projects } from '../data/projects';

const interests = [
  { name: 'Ironman and triathlon', summary: 'One 140.6 and four 70.3s, and a habit of training by the data.' },
  { name: 'Bluegrass and vinyl', summary: 'Music from home, and records played start to finish.' },
  { name: 'Horse racing', summary: 'Part of being a proud Kentuckian.' },
  { name: 'Bourbon', summary: 'The industry and the craft, another piece of home.' },
];
const card = 'bg-chalk border border-concrete p-6 space-y-3';
const name = 'font-display font-bold text-lg uppercase leading-snug';
---

<Layout title="My interests · Harrison Keith">
  <section class="max-w-6xl mx-auto w-full px-6 pt-14 space-y-14">
    <div>
      <PageHeading title="My Interests" />
      <ul class="grid gap-4 md:grid-cols-2">
        {interests.map((i) => (
          <li class={card}>
            <h2 class={name}>{i.name}</h2>
            <p>{i.summary}</p>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="font-display font-bold text-xl uppercase border-t border-carbon pt-5 mb-6">Projects</h2>
      <ul class="grid gap-4 md:grid-cols-2">
        {projects.map((p) => (
          <li class={card}>
            <p class="font-technical text-[10px] uppercase text-racingRed font-bold">{p.status}</p>
            <h3 class={name}>{p.name}</h3>
            <p>{p.summary}</p>
            {p.url && <a href={p.url} rel="noopener noreferrer" class="inline-block py-2 font-bold underline">Open project</a>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
