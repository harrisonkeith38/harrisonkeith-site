---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About — HARRISON KEITH"
  description="Professional background of Harrison Keith. Brand strategy, McCombs MBA, U.S. Army Officer."
>
  <div class="max-w-5xl mx-auto px-6 py-16 sm:py-20 space-y-16">
    <!-- Header -->
    <header class="space-y-4 pb-12 border-b border-concrete/30">
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1">
          <span class="w-2.5 h-[3px] bg-signalYellow transform -skew-x-12 inline-block"></span>
          <span class="w-2.5 h-[3px] bg-racingRed transform -skew-x-12 inline-block"></span>
          <span class="w-2.5 h-[3px] bg-alpineBlue transform -skew-x-12 inline-block"></span>
        </div>
        <span class="text-xs font-technical uppercase tracking-extended text-concrete">
          OVERVIEW // BACKGROUND
        </span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-carbon uppercase tracking-tight">
        Harrison Keith
      </h1>
      <p class="text-sm font-sans text-carbon/80 max-w-xl leading-relaxed">
        Brand strategist and former U.S. Army Officer based in Austin, Texas.
      </p>
    </header>

    <!-- Grid: Portrait & Core Background -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
      <!-- Portrait -->
      <div class="md:col-span-4">
        <div class="w-full aspect-[4/5] bg-chalk border border-concrete/40 relative overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=800&q=80"
            alt="Harrison Keith"
            class="w-full h-full object-cover grayscale contrast-110"
          />
        </div>
      </div>

      <!-- Core Facts (No Fluff) -->
      <div class="md:col-span-8 space-y-8">
        <div class="space-y-3">
          <h2 class="font-display font-bold text-xl text-carbon uppercase tracking-wide">
            Intersection of Discipline & Strategy
          </h2>
          <p class="font-sans text-sm text-carbon/90 leading-relaxed font-light">
            My background combines military leadership and operational execution as a U.S. Army Officer, business education through the University of Texas McCombs MBA program, brand management and marketing strategy across heritage and high-growth consumer products, and personal pursuits in endurance athletics and visual culture.
          </p>
        </div>

        <div class="space-y-4 pt-4 border-t border-concrete/30 text-xs font-technical uppercase tracking-extended">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="border border-concrete/30 p-4 bg-chalk">
              <span class="text-concrete block text-[10px]">OPERATIONAL FOUNDATION</span>
              <strong class="font-display font-bold text-sm text-carbon block mt-1">U.S. Army Officer</strong>
              <span class="text-carbon/70 text-xs normal-case block mt-0.5">Mission command & cross-functional leadership</span>
            </div>

            <div class="border border-concrete/30 p-4 bg-chalk">
              <span class="text-concrete block text-[10px]">BUSINESS ARCHITECTURE</span>
              <strong class="font-display font-bold text-sm text-carbon block mt-1">McCombs MBA</strong>
              <span class="text-carbon/70 text-xs normal-case block mt-0.5">Brand management & marketing strategy</span>
            </div>
          </div>
        </div>

        <div class="pt-4 flex items-center gap-4 text-xs font-technical uppercase tracking-extended">
          <a
            href="/timeline"
            class="px-5 py-2.5 bg-carbon text-chalk hover:bg-racingRed transition-colors font-bold inline-flex items-center gap-2"
          >
            <span>View Complete Career Timeline</span>
            <span>&rarr;</span>
          </a>
          <a
            href="/harrison-keith-resume.pdf"
            target="_blank"
            class="px-5 py-2.5 border border-concrete text-carbon hover:border-carbon transition-colors font-bold"
          >
            Download Résumé (PDF) &darr;
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
