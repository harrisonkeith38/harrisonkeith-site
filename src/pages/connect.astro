---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Connect — HARRISON KEITH"
  description="Direct contact information, professional dialogue, and advisory inquiries for Harrison Keith."
>
  <div class="max-w-4xl mx-auto px-6 py-16 sm:py-20">
    <!-- Header -->
    <header class="space-y-4 pb-12 border-b border-concrete/30">
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1">
          <span class="w-2.5 h-[3px] bg-signalYellow transform -skew-x-12 inline-block"></span>
          <span class="w-2.5 h-[3px] bg-racingRed transform -skew-x-12 inline-block"></span>
          <span class="w-2.5 h-[3px] bg-alpineBlue transform -skew-x-12 inline-block"></span>
        </div>
        <span class="text-xs font-technical uppercase tracking-extended text-concrete">
          INQUIRIES & DIALOGUE
        </span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-carbon uppercase tracking-tight">
        Connect & Inquiries
      </h1>
      <p class="text-sm font-sans text-carbon/80 max-w-xl leading-relaxed">
        Open to brand marketing leadership opportunities, strategic advisory, and collaborative dialogues with ambitious founders and operators.
      </p>
    </header>

    <!-- Contact Directory -->
    <div class="py-12 divide-y divide-concrete/30 border-b border-concrete/30">
      <!-- Direct Email & Copy Button -->
      <div class="py-8 grid grid-cols-1 sm:grid-cols-12 gap-4 items-baseline">
        <div class="sm:col-span-4">
          <span class="text-xs font-technical uppercase tracking-extended text-concrete block">
            PRIMARY INBOX
          </span>
          <span class="text-xs font-sans text-concrete">Executive & Advisory</span>
        </div>
        <div class="sm:col-span-8 flex flex-wrap items-center gap-4">
          <a
            href="mailto:contact@jharrisonkeith.com"
            class="font-display font-bold text-xl sm:text-2xl text-carbon hover:text-racingRed transition-colors uppercase tracking-tight"
          >
            contact@jharrisonkeith.com
          </a>
          <button
            id="copy-btn"
            class="px-3 py-1 text-[11px] font-technical uppercase tracking-extended border border-concrete/50 hover:border-carbon text-carbon transition-all"
          >
            Copy Address
          </button>
        </div>
      </div>

      <!-- LinkedIn -->
      <div class="py-8 grid grid-cols-1 sm:grid-cols-12 gap-4 items-baseline">
        <div class="sm:col-span-4">
          <span class="text-xs font-technical uppercase tracking-extended text-concrete block">
            NETWORK
          </span>
          <span class="text-xs font-sans text-concrete">Professional Profile</span>
        </div>
        <div class="sm:col-span-8">
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="font-display font-bold text-xl text-carbon hover:text-racingRed transition-colors uppercase tracking-tight inline-flex items-center gap-1.5"
          >
            <span>LinkedIn Profile</span>
            <span class="text-sm">&nearr;</span>
          </a>
        </div>
      </div>

      <!-- Résumé Direct PDF Download -->
      <div class="py-8 grid grid-cols-1 sm:grid-cols-12 gap-4 items-baseline">
        <div class="sm:col-span-4">
          <span class="text-xs font-technical uppercase tracking-extended text-concrete block">
            DOCUMENTATION
          </span>
          <span class="text-xs font-sans text-concrete">Official Credentials</span>
        </div>
        <div class="sm:col-span-8">
          <a
            href="/harrison-keith-resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 bg-carbon text-chalk hover:bg-racingRed transition-colors text-xs font-technical uppercase font-bold tracking-extended inline-flex items-center gap-2"
          >
            <span>Download Full Résumé (PDF)</span>
            <span>&darr;</span>
          </a>
        </div>
      </div>

      <!-- Location Base -->
      <div class="py-8 grid grid-cols-1 sm:grid-cols-12 gap-4 items-baseline">
        <div class="sm:col-span-4">
          <span class="text-xs font-technical uppercase tracking-extended text-concrete block">
            LOCATION
          </span>
          <span class="text-xs font-sans text-concrete">Base of Operations</span>
        </div>
        <div class="sm:col-span-8">
          <span class="font-display font-bold text-lg text-carbon uppercase tracking-wider block">
            Austin, Texas
          </span>
          <span class="text-xs font-technical text-concrete uppercase tracking-extended block mt-0.5">
            Central Time (CT) &bull; Available for Travel & Select Engagements
          </span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('contact@jharrisonkeith.com');
      copyBtn.innerText = 'COPIED ✓';
      copyBtn.classList.add('bg-carbon', 'text-chalk');
      setTimeout(() => {
        copyBtn.innerText = 'COPY ADDRESS';
        copyBtn.classList.remove('bg-carbon', 'text-chalk');
      }, 2000);
    });
  }
</script>
