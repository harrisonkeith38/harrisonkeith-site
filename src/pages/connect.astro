---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Connect — Harrison Keith"
  description="Direct contact information, professional dialogue, and advisory inquiries for J. Harrison Keith."
>
  <div class="max-w-4xl mx-auto px-6 sm:px-8 py-20">
    <!-- Header -->
    <header class="space-y-6 pb-16 border-b border-bone-300">
      <div class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-widest text-graphite-500">
        <span class="w-1.5 h-1.5 rounded-full bg-burnt-600"></span>
        <span>05 // Inquiries & Dialogue</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-medium tracking-tight text-carbon-900 leading-[1.02]">
        Let’s start a conversation.
      </h1>
      <p class="text-lg sm:text-xl text-graphite-600 font-light leading-relaxed max-w-xl font-sans">
        Open to brand marketing leadership opportunities, strategic advisory, and collaborative dialogues with ambitious founders and operators.
      </p>
    </header>

    <!-- Clean Editorial Directory (Container-Free) -->
    <div class="py-12 divide-y divide-bone-300 border-b border-bone-300">
      <!-- Direct Email -->
      <div class="py-10 grid grid-cols-1 sm:grid-cols-12 gap-6 items-baseline group">
        <div class="sm:col-span-4">
          <span class="text-xs font-mono uppercase tracking-widest text-burnt-600 font-bold block">
            Primary Channel
          </span>
          <span class="text-sm font-sans text-graphite-500">Executive & Advisory Inquiries</span>
        </div>
        <div class="sm:col-span-8">
          <a
            href="mailto:contact@jharrisonkeith.com"
            class="font-serif text-2xl sm:text-3xl text-carbon-900 group-hover:text-burnt-600 font-medium transition-colors inline-flex items-center gap-2"
          >
            <span>contact@jharrisonkeith.com</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- LinkedIn -->
      <div class="py-10 grid grid-cols-1 sm:grid-cols-12 gap-6 items-baseline group">
        <div class="sm:col-span-4">
          <span class="text-xs font-mono uppercase tracking-widest text-burnt-600 font-bold block">
            Network
          </span>
          <span class="text-sm font-sans text-graphite-500">Professional Profile</span>
        </div>
        <div class="sm:col-span-8">
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="font-serif text-2xl sm:text-3xl text-carbon-900 group-hover:text-burnt-600 font-medium transition-colors inline-flex items-center gap-2"
          >
            <span>linkedin.com/in/harrisonkeith</span>
            <span class="group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform">&nearr;</span>
          </a>
        </div>
      </div>

      <!-- Base -->
      <div class="py-10 grid grid-cols-1 sm:grid-cols-12 gap-6 items-baseline">
        <div class="sm:col-span-4">
          <span class="text-xs font-mono uppercase tracking-widest text-graphite-500 block">
            Location
          </span>
          <span class="text-sm font-sans text-graphite-500">Base of Operations</span>
        </div>
        <div class="sm:col-span-8">
          <span class="font-serif text-2xl text-carbon-900 block font-medium">
            Austin, Texas
          </span>
          <span class="text-xs font-mono text-graphite-500 block mt-1">
            Central Time (CT) &bull; Open to selective travel and hybrid leadership
          </span>
        </div>
      </div>

      <!-- Résumé Upon Request -->
      <div class="py-10 grid grid-cols-1 sm:grid-cols-12 gap-6 items-baseline">
        <div class="sm:col-span-4">
          <span class="text-xs font-mono uppercase tracking-widest text-graphite-500 block">
            Credentials
          </span>
          <span class="text-sm font-sans text-graphite-500">Official Documentation</span>
        </div>
        <div class="sm:col-span-8 space-y-1">
          <span class="font-serif text-2xl text-carbon-900 block font-medium">
            Full Executive Résumé PDF
          </span>
          <p class="text-xs text-graphite-600 leading-relaxed font-sans font-light">
            Available directly upon request to protect personal phone and contact details. Send an email and I will reply with the latest dossier.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
