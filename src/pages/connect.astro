---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Connect — Harrison Keith"
  description="Direct contact information, professional dialogue, and advisory inquiries for J. Harrison Keith."
>
  <div class="max-w-4xl mx-auto px-6 py-16">
    <!-- Header -->
    <div class="space-y-4 pb-12 border-b border-bone-300">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-burnt-600 font-semibold">
        <span>05 // Inquiries & Dialogue</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-medium tracking-tight text-carbon-900 leading-tight">
        Let’s start a conversation.
      </h1>
      <p class="text-base text-graphite-600 max-w-xl font-normal leading-relaxed">
        I am always interested in discussing strategic brand leadership opportunities, advisory roles, and conversations with ambitious operators and founders.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="py-12 grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Card 1: Direct Email -->
      <div class="bg-bone-50 border border-bone-300 rounded-sm p-8 space-y-6 flex flex-col justify-between hover:border-carbon-800 transition-all">
        <div class="space-y-2">
          <span class="text-xs font-mono uppercase tracking-wider text-burnt-600 font-semibold">
            Primary Channel
          </span>
          <h2 class="font-serif text-2xl font-medium text-carbon-900">
            Direct Email
          </h2>
          <p class="text-xs text-graphite-600 leading-relaxed">
            For executive recruitment, strategic consulting inquiries, or thoughtful introductions.
          </p>
        </div>

        <div class="pt-6 border-t border-bone-200">
          <a
            href="mailto:contact@jharrisonkeith.com"
            class="inline-flex items-center gap-2 text-base font-mono text-carbon-900 hover:text-burnt-600 font-medium transition-colors"
          >
            <span>contact@jharrisonkeith.com</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Card 2: LinkedIn -->
      <div class="bg-bone-50 border border-bone-300 rounded-sm p-8 space-y-6 flex flex-col justify-between hover:border-carbon-800 transition-all">
        <div class="space-y-2">
          <span class="text-xs font-mono uppercase tracking-wider text-burnt-600 font-semibold">
            Professional Network
          </span>
          <h2 class="font-serif text-2xl font-medium text-carbon-900">
            LinkedIn
          </h2>
          <p class="text-xs text-graphite-600 leading-relaxed">
            Connect directly, follow recent updates, or message me through the platform.
          </p>
        </div>

        <div class="pt-6 border-t border-bone-200">
          <a
            href="https://www.linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-base font-mono text-carbon-900 hover:text-burnt-600 font-medium transition-colors"
          >
            <span>View LinkedIn Profile</span>
            <span>&nearr;</span>
          </a>
        </div>
      </div>

      <!-- Card 3: Location & Timezone -->
      <div class="bg-bone-50 border border-bone-300 rounded-sm p-8 space-y-4">
        <span class="text-xs font-mono uppercase tracking-wider text-graphite-500">
          Base of Operations
        </span>
        <h3 class="font-serif text-xl font-medium text-carbon-900">
          Austin, Texas
        </h3>
        <p class="text-xs text-graphite-600 leading-relaxed">
          Central Time (CT). Open to travel and selective hybrid or on-site strategic engagements.
        </p>
      </div>

      <!-- Card 4: Résumé Upon Request -->
      <div class="bg-bone-50 border border-bone-300 rounded-sm p-8 space-y-4">
        <span class="text-xs font-mono uppercase tracking-wider text-graphite-500">
          Credentials
        </span>
        <h3 class="font-serif text-xl font-medium text-carbon-900">
          Full Executive Résumé
        </h3>
        <p class="text-xs text-graphite-600 leading-relaxed">
          Available directly upon request to protect personal contact information. Send an email and I will provide the latest PDF.
        </p>
      </div>
    </div>
  </div>
</Layout>
