---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Stand-ins for the licensed kit fonts: Panchang (display), General Sans (body), Martian Mono (labels).
import '@fontsource-variable/martian-mono/wdth.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HARRISON KEITH',
  description = 'Harrison Keith. MBA candidate at Texas McCombs and U.S. Army veteran.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-chalk text-carbon antialiased selection:bg-carbon selection:text-chalk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=panchang@700,800&display=swap" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jharrisonkeith.com" />
  </head>
  <body class="min-h-screen flex flex-col bg-chalk text-carbon font-sans bg-topography">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
