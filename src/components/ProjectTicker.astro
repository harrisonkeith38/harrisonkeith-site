---
interface TickerItem {
  index: string;
  title: string;
  category: string;
}

const items: TickerItem[] = [
  { index: '01', title: 'Jim Beam', category: 'Heritage Spirits Repositioning' },
  { index: '02', title: 'YETI', category: 'Brand Elasticity & Cult Loyalty' },
  { index: '03', title: 'U.S. Army', category: 'Mission Command & Decentralized Execution' },
  { index: '04', title: 'Endurance Athletics', category: 'Grassroots Performance Culture' },
  { index: '05', title: 'McCombs MBA', category: 'Brand Management & Market Architecture' },
];
---

<div class="w-full border-y border-bone-300 bg-bone-50/50 py-3 overflow-hidden group select-none">
  <div class="flex space-x-12 animate-marquee group-hover:[animation-play-state:paused] whitespace-nowrap">
    <!-- Stream 1 -->
    {items.map((item) => (
      <a
        href="/projects"
        class="inline-flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-carbon-800 hover:text-burnt-600 transition-colors"
      >
        <span class="text-burnt-600 font-semibold">[{item.index}]</span>
        <span class="font-bold text-carbon-900">{item.title}</span>
        <span class="text-graphite-500 font-normal">/ {item.category}</span>
        <span class="text-graphite-400 pl-4">&bull;</span>
      </a>
    ))}

    <!-- Stream 2 (Seamless loop) -->
    {items.map((item) => (
      <a
        href="/projects"
        class="inline-flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-carbon-800 hover:text-burnt-600 transition-colors"
      >
        <span class="text-burnt-600 font-semibold">[{item.index}]</span>
        <span class="font-bold text-carbon-900">{item.title}</span>
        <span class="text-graphite-500 font-normal">/ {item.category}</span>
        <span class="text-graphite-400 pl-4">&bull;</span>
      </a>
    ))}
  </div>
</div>
