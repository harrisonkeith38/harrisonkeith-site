---
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-concrete/30 bg-chalk text-carbon mt-28">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-10 pb-12 border-b border-concrete/30">
      <!-- Stacked lockup -->
      <img src="/brand/hk-lockup.png" alt="Harrison Keith" width="847" height="321" class="w-44 h-auto" />

      <!-- Contact links -->
      <div class="flex flex-col gap-2 text-xs font-technical">
        <a href="https://www.linkedin.com/in/harrison-keith38/" rel="noopener noreferrer" class="flex items-center gap-2 text-carbon font-bold hover:text-racingRed py-1 uppercase tracking-extended"><Icon name="communication" />LinkedIn</a>
      </div>
    </div>

    <div class="pt-8 text-[10px] font-technical uppercase tracking-extended text-carbon">
      &copy; {currentYear} HARRISON KEITH
    </div>
  </div>
</footer>
