---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-concrete/30 bg-chalk text-carbon mt-28">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-10 pb-12 border-b border-concrete/30">
      <!-- Centered Stacked Logo Motif -->
      <div class="space-y-3">
        <!-- HK Monogram -->
        <div class="w-8 h-7">
          <svg viewBox="0 0 130 100" fill="none" class="w-full h-full">
            <g transform="skewX(-12) translate(22, 0)">
              <rect x="0" y="0" width="18" height="100" fill="#141414" />
              <rect x="18" y="42" width="24" height="16" fill="#141414" />
              <rect x="42" y="0" width="18" height="100" fill="#141414" />
              <polygon points="56,42 78,0 98,0 68,54" fill="#141414" />
              <polygon points="65,48 98,100 78,100 52,56" fill="#141414" />
            </g>
          </svg>
        </div>

        <span class="font-display font-extrabold text-sm tracking-extended text-carbon uppercase block">
          HARRISON KEITH
        </span>

        <!-- 3 Signature Stripes: Yellow, Red, Blue -->
        <div class="flex items-center gap-1">
          <span class="w-3 h-[3px] bg-signalYellow transform -skew-x-12 inline-block"></span>
          <span class="w-3 h-[3px] bg-racingRed transform -skew-x-12 inline-block"></span>
          <span class="w-3 h-[3px] bg-alpineBlue transform -skew-x-12 inline-block"></span>
        </div>
      </div>

      <!-- Navigation & Links -->
      <div class="flex flex-wrap items-center gap-x-8 gap-y-3 text-xs font-technical uppercase tracking-extended">
        <a href="/timeline" class="text-concrete hover:text-carbon transition-colors">Timeline</a>
        <a href="/projects" class="text-concrete hover:text-carbon transition-colors">Projects</a>
        <a href="/interests" class="text-concrete hover:text-carbon transition-colors">Interests</a>
        <a href="/connect" class="text-concrete hover:text-carbon transition-colors">Connect</a>
        <a href="/harrison-keith-resume.pdf" target="_blank" class="text-carbon hover:text-racingRed font-bold transition-colors">Résumé (PDF) &darr;</a>
      </div>

      <!-- Direct Reachout -->
      <div class="text-xs font-technical text-concrete">
        <span>INQUIRIES:</span>
        <a href="mailto:contact@jharrisonkeith.com" class="text-carbon font-bold hover:text-racingRed ml-1.5 transition-colors">
          contact@jharrisonkeith.com &rarr;
        </a>
      </div>
    </div>

    <!-- Bottom Colophon -->
    <div class="pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-[10px] font-technical uppercase tracking-extended text-concrete">
      <div>
        &copy; {currentYear} HARRISON KEITH. ALL RIGHTS RESERVED.
      </div>
      <div>
        TECHNICAL PERFORMANCE &bull; MODERN MINIMALISM
      </div>
    </div>
  </div>
</footer>
