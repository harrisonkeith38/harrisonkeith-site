---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-bone-300 bg-bone-100 text-carbon-900 mt-24">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-16 border-b border-bone-300">
      <!-- Col 1: Bio / Philosophy -->
      <div class="md:col-span-5 space-y-4">
        <span class="font-serif text-2xl font-medium tracking-tight text-carbon-900 block">
          Harrison Keith
        </span>
        <p class="text-sm text-graphite-600 max-w-sm leading-relaxed">
          The intersection of military leadership, McCombs MBA business strategy, and brand marketing. Unbound in curiosity, disciplined in execution.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-mono uppercase tracking-wider bg-bone-200 border border-bone-300 text-carbon-800">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Based in Austin, Texas
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs font-mono uppercase tracking-wider text-graphite-500">Navigation</h4>
        <ul class="space-y-2 text-sm font-sans">
          <li><a href="/about" class="hover:text-burnt-600 transition-colors">About Me</a></li>
          <li><a href="/timeline" class="hover:text-burnt-600 transition-colors">Career Timeline</a></li>
          <li><a href="/projects" class="hover:text-burnt-600 transition-colors">My Projects</a></li>
          <li><a href="/interests" class="hover:text-burnt-600 transition-colors">My Interests</a></li>
          <li><a href="/connect" class="hover:text-burnt-600 transition-colors">Connect</a></li>
        </ul>
      </div>

      <!-- Col 3: Direct Connect -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-xs font-mono uppercase tracking-wider text-graphite-500">Inquiries & Dialogue</h4>
        <p class="text-sm text-graphite-600 leading-relaxed">
          Open to brand marketing leadership, strategic advisory, and collaborative dialogues with visionary operators.
        </p>
        <div class="pt-2 flex flex-col space-y-2">
          <a
            href="mailto:contact@jharrisonkeith.com"
            class="inline-flex items-center gap-2 text-sm font-mono text-burnt-600 hover:text-burnt-700 font-medium"
          >
            <span>contact@jharrisonkeith.com</span>
            <span>&rarr;</span>
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-graphite-600 hover:text-carbon-900 transition-colors"
          >
            LinkedIn Profile &nearr;
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-graphite-500">
      <div>
        &copy; {currentYear} J. Harrison Keith. All rights reserved.
      </div>
      <div class="flex items-center gap-6">
        <span>Designed with Intention</span>
        <span>&bull;</span>
        <span>Fast, Zero-JS Architecture</span>
      </div>
    </div>
  </div>
</footer>
