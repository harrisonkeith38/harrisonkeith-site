---
import LockupSide from './LockupSide.astro';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { href: '/', label: 'Home', icon: 'system-grid' },
  { href: '/path', label: 'My Path', icon: 'direction' },
  { href: '/brand', label: 'My Brand', icon: 'identity' },
  { href: '/projects', label: 'My Projects', icon: 'product' },
];
---

<header class="sticky top-0 z-50 bg-chalk/95 backdrop-blur-md border-b border-concrete/30">
  <div class="max-w-6xl mx-auto px-4 min-[360px]:px-6 h-18 py-3.5 flex items-center justify-between">
    <!-- Brand: HK mark and wordmark, cut from the supplied artwork -->
    <a href="/" class="flex items-center gap-3 select-none" aria-label="Harrison Keith, home">
      <LockupSide />
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-8 text-xs font-technical uppercase">
      {navItems.map((item) => (
        <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined} class={`flex items-center gap-2 py-2 border-b-2 hover:text-racingRed ${pathname === item.href ? 'border-racingRed font-bold' : 'border-transparent'}`}>
          <Icon name={item.icon} />
          {item.label}
        </a>
      ))}
    </nav>

    <details class="md:hidden relative text-xs font-technical uppercase">
      <summary class="list-none cursor-pointer py-3 px-1 font-bold">Menu</summary>
      <nav aria-label="Primary mobile" class="absolute right-0 mt-1 w-48 bg-chalk border border-carbon p-3 flex flex-col">
        {navItems.map((item) => (
          <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined} class="flex items-center gap-3 py-3 hover:text-racingRed"><Icon name={item.icon} />{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
