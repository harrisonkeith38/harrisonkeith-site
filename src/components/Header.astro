---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { href: '/about', label: 'About Me' },
  { href: '/timeline', label: 'Career Timeline' },
  { href: '/projects', label: 'My Projects' },
  { href: '/interests', label: 'My Interests' },
  { href: '/connect', label: 'Connect' },
];
---

<header class="sticky top-0 z-50 bg-bone-100/90 backdrop-blur-md border-b border-bone-300 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Brand Name / Logo -->
    <a href="/" class="group flex flex-col">
      <span class="font-serif text-2xl font-semibold tracking-tight text-carbon-900 group-hover:text-burnt-600 transition-colors">
        Harrison Keith
      </span>
      <span class="text-[10px] font-mono uppercase tracking-widest text-graphite-500">
        Austin, TX &bull; Strategy & Leadership
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-8">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`relative text-xs uppercase tracking-wider font-mono py-1 transition-all ${
              isActive
                ? 'text-burnt-600 font-semibold'
                : 'text-carbon-800 hover:text-burnt-600'
            }`}
          >
            {item.label}
            {isActive && (
              <span class="absolute bottom-0 left-0 w-full h-[1.5px] bg-burnt-600 rounded-full" />
            )}
          </a>
        );
      })}
      
      <!-- Connect CTA -->
      <a
        href="/connect"
        class="text-xs uppercase font-mono tracking-wider px-4 py-2 border border-carbon-800 hover:border-burnt-600 hover:bg-burnt-600 hover:text-bone-50 text-carbon-900 rounded-sm transition-all duration-150"
      >
        Get in Touch
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-carbon-900 hover:text-burnt-600 focus:outline-none"
      aria-label="Toggle navigation menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-bone-300 bg-bone-100 px-6 py-6 space-y-4">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block font-mono text-sm uppercase tracking-wider text-carbon-900 hover:text-burnt-600 py-2 border-b border-bone-200"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
