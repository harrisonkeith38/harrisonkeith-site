---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { href: '/about', label: 'About' },
  { href: '/timeline', label: 'Timeline' },
  { href: '/projects', label: 'Projects' },
  { href: '/interests', label: 'Interests' },
  { href: '/connect', label: 'Connect' },
];
---

<header class="sticky top-0 z-50 bg-bone-100/95 backdrop-blur-md border-b border-bone-300">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 h-20 flex items-center justify-between">
    <!-- Brand Name / Logo -->
    <a href="/" class="group flex items-baseline gap-3">
      <span class="font-serif text-2xl sm:text-3xl font-medium tracking-tight text-carbon-900 group-hover:text-burnt-600 transition-colors">
        Harrison Keith
      </span>
      <span class="hidden sm:inline-block text-[10px] font-mono uppercase tracking-widest text-graphite-500">
        Austin, TX &bull; 30.2672° N, 97.7431° W
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-7">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`text-[11px] uppercase tracking-widest font-mono transition-colors flex items-center gap-1.5 ${
              isActive
                ? 'text-burnt-600 font-semibold'
                : 'text-carbon-800 hover:text-burnt-600'
            }`}
          >
            {isActive && <span class="w-1.5 h-1.5 rounded-full bg-burnt-600"></span>}
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-carbon-900 hover:text-burnt-600 focus:outline-none"
      aria-label="Toggle navigation"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8h18M3 16h18" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-bone-300 bg-bone-100 px-6 py-6 space-y-4">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block font-mono text-xs uppercase tracking-widest text-carbon-900 hover:text-burnt-600 py-1.5 border-b border-bone-200"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
